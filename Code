#include <stdio.h>

char b[3][3] = {{'1','2','3'},{'4','5','6'},{'7','8','9'}};

void show() {
    printf("\n");
    for (int i = 0; i < 3; i++) {
        printf(" %c | %c | %c \n", b[i][0], b[i][1], b[i][2]);
        if (i < 2) printf("---|---|---\n");
    }
}

int check() {
    for (int i = 0; i < 3; i++) {
        if (b[i][0] == b[i][1] && b[i][1] == b[i][2]) return 1; // строки
        if (b[0][i] == b[1][i] && b[1][i] == b[2][i]) return 1; // столбцы
    }
    if (b[0][0] == b[1][1] && b[1][1] == b[2][2]) return 1; // главная диагональ
    if (b[0][2] == b[1][1] && b[1][1] == b[2][0]) return 1; // побочная диагональ
    for (int i = 0; i < 9; i++) if (b[i/3][i%3] != 'X' && b[i/3][i%3] != 'O') return -1;
    return 0; // ничья
}

int main() {
    int p = 1, st = -1, c;
    while (st == -1) {
        show();
        char m = (p == 1) ? 'X' : 'O';
        printf("Игрок %d (%c), ход (1-9): ", p, m);
        if (scanf("%d", &c) == 1 && c >= 1 && c <= 9 && b[(c-1)/3][(c-1)%3] != 'X' && b[(c-1)/3][(c-1)%3] != 'O') {
            b[(c-1)/3][(c-1)%3] = m;
            st = check();
            if (st == -1) p = (p == 1) ? 2 : 1;
        } else printf("Ошибка! Попробуйте снова.\n");
    }
    show();
    if (st == 1) printf("Победил Игрок %d!\n", p);
    else printf("Ничья!\n");
}
