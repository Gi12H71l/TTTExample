#include <stdio.h>

int main() {
    char b[3][3]={{'1','2','3'},{'4','5','6'},{'7','8','9'}};
    int n,p=1,m=0,s=-1,i,j;

    while(s==-1) {
        for(i=0;i<3;i++) {
            for(j=0;j<3;j++) printf(" %c ",b[i][j]);
            printf("\n");
        }

        printf("Player %d: ",p);
        scanf("%d",&n);

        i=(n-1)/3;
        j=(n-1)%3;

        if(n<1n>9b[i][j]=='X'||b[i][j]=='O') {
            printf("Error!\n");
            continue;
        }

        b[i][j]=p==1?'X':'O';
        m++;

        if(
            (b[0][0]==b[0][1]&&b[0][1]==b[0][2])||
            (b[1][0]==b[1][1]&&b[1][1]==b[1][2])||
            (b[2][0]==b[2][1]&&b[2][1]==b[2][2])||
            (b[0][0]==b[1][0]&&b[1][0]==b[2][0])||
            (b[0][1]==b[1][1]&&b[1][1]==b[2][1])||
            (b[0][2]==b[1][2]&&b[1][2]==b[2][2])||
            (b[0][0]==b[1][1]&&b[1][1]==b[2][2])||
            (b[0][2]==b[1][1]&&b[1][1]==b[2][0])
        ) s=1;
        else if(m==9) s=0;
        else p=p==1?2:1;
    }

    for(i=0;i<3;i++) {
        for(j=0;j<3;j++) printf(" %c ",b[i][j]);
        printf("\n");
    }

    if(s) printf("Player %d win!",p);
    else printf("Draw!");

    return 0;
}
